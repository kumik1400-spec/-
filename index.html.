var CT=[{n:'Бордо',bg:'#4A0D0D',fg:'#E8D5B5'},{n:'Крем',bg:'#F5EBDD',fg:'#4A0D0D'},{n:'Ночь',bg:'#111111',fg:'#c9a24a'}],CF=[['Playfair, жирный','700 {s}px "Playfair Display",Georgia,serif'],['Playfair, курсив','italic 500 {s}px "Playfair Display",Georgia,serif'],['Jost, лёгкий','300 {s}px Jost,sans-serif'],['Georgia, курсив','italic {s}px Georgia,serif']];
var C={t:0,f:1,col:'#E8D5B5',txt:'Цветы, которые говорят вместо слов'};
function wrapT(x,t,m){var out=[];t.split('\n').forEach(function(par){var l='';par.split(' ').forEach(function(w){var tt=l?l+' '+w:w;if(x.measureText(tt).width>m&&l){out.push(l);l=w}else l=tt});out.push(l)});return out}
function drawCard(){var cv=$('#cv'),x=cv.getContext('2d'),T=CT[C.t],W=600,H=420,size=46,ln;
x.globalAlpha=1;x.fillStyle=T.bg;x.fillRect(0,0,W,H);x.strokeStyle=T.fg;x.lineWidth=1.5;x.globalAlpha=.7;x.strokeRect(22,22,W-44,H-44);x.strokeRect(30,30,W-60,H-60);
[[70,70],[W-70,70],[70,H-70],[W-70,H-70]].forEach(function(c){x.fillStyle=T.fg;for(var i=0;i<5;i++){var a=i*Math.PI*2/5;x.globalAlpha=.5;x.beginPath();x.arc(c[0]+Math.cos(a)*9,c[1]+Math.sin(a)*9,6,0,7);x.fill()}x.globalAlpha=.9;x.beginPath();x.arc(c[0],c[1],4,0,7);x.fill()});
x.globalAlpha=1;for(;size>=18;size-=2){x.font=CF[C.f][1].replace('{s}',size);ln=wrapT(x,C.txt||' ',W-190);if(ln.length*size*1.25<=H-190)break}
x.fillStyle=C.col;x.textAlign='center';x.textBaseline='middle';var lh=size*1.25,y0=H/2-(ln.length-1)*lh/2;ln.forEach(function(l,i){x.fillText(l,W/2,y0+i*lh)})}
