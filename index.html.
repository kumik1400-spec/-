.ico{display:flex;gap:2px}.ib{position:relative;width:42px;height:42px;display:grid;place-items:center;transition:.25s}.ib:hover{color:#fff;background:rgba(232,213,181,.12)}
.cnt{position:absolute;top:3px;right:1px;min-width:17px;height:17px;background:var(--bg);color:var(--bd);font-size:11px;font-weight:500;display:grid;place-items:center;padding:0 3px}.cnt[data-n="0"]{display:none}
.burger{display:none}
.hero{padding:70px 0 100px;overflow:hidden}.hg{display:grid;grid-template-columns:1.1fr 1fr;gap:40px;align-items:center}
