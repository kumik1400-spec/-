.hero h1{font-weight:800;font-size:clamp(52px,9.5vw,138px);letter-spacing:-.02em;color:var(--bd);text-transform:uppercase}.hero h1 span{display:block;font-style:italic;font-weight:500;color:var(--bk);margin-left:.5em}
.hero .sub{font-family:var(--serif);font-style:italic;font-size:clamp(20px,2.4vw,28px);margin:26px 0 34px;max-width:440px;border-left:3px solid var(--bd);padding-left:18px}
.hv{position:relative;min-height:520px}
.hv .ph1{position:absolute;inset:0 0 0 8%;clip-path:polygon(2% 3%,12% 0,25% 2%,40% 0,58% 3%,75% 0,90% 2%,100% 1%,98% 18%,100% 34%,97% 52%,100% 70%,98% 86%,100% 100%,80% 98%,62% 100%,44% 97%,28% 100%,12% 98%,0 100%,2% 80%,0 62%,3% 44%,0 26%);background:var(--bd)}
.hv img{width:100%;height:100%;object-fit:cover;filter:sepia(.25) contrast(1.05) saturate(.95)}
.stamp{position:absolute;left:0;bottom:30px;background:var(--ml);color:var(--bd);padding:16px 20px;transform:rotate(-4deg);box-shadow:0 10px 24px rgba(0,0,0,.3);font-family:var(--serif);z-index:2;clip-path:polygon(0 3%,8% 0,30% 3%,55% 0,80% 3%,100% 0,98% 50%,100% 100%,70% 97%,45% 100%,20% 97%,0 100%,2% 50%)}
