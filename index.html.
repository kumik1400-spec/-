@keyframes mq{to{transform:translateX(-50%)}}
.sh{display:flex;align-items:flex-end;gap:22px;border-bottom:1px solid currentColor;padding-bottom:16px;margin-bottom:44px;flex-wrap:wrap}
.sh small{font-size:12px;letter-spacing:.3em;text-transform:uppercase;opacity:.7;padding-bottom:10px}.sh h2{font-size:clamp(36px,6vw,78px);font-weight:800;text-transform:uppercase;letter-spacing:-.01em}.sh h2 i{font-weight:500}
.cols{display:grid;grid-template-columns:repeat(6,1fr);gap:20px;align-items:start}
