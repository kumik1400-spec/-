*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html{scroll-behavior:smooth;scroll-padding-top:70px}
body{font-family:var(--sans);background:var(--bk);color:var(--bk);line-height:1.55;overflow-x:hidden}
img{display:block;max-width:100%}button{font:inherit;cursor:pointer;border:0;background:none;color:inherit}a{color:inherit;text-decoration:none}
h1,h2,h3,h4{font-family:var(--serif);font-weight:500;line-height:1.05}
.wrap{max-width:1280px;margin:auto;padding:0 22px}
svg.i{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
.s{position:relative;padding:96px 0}
.s:before{content:"";position:absolute;left:0;right:0;top:-15px;height:16px;background:var(--c);-webkit-mask:var(--torn) repeat-x 0 0/240px 16px;mask:var(--torn) repeat-x 0 0/240px 16px;z-index:2}
.bd{--c:var(--bd);background:var(--bd);color:var(--bg)}.bk{--c:var(--bk);background:var(--bk);color:var(--bg)}
.pa{--c:var(--bg);background:var(--bg) var(--paper);color:var(--bk)}.ml{--c:var(--ml);background:var(--ml) var(--paper);color:var(--bk)}
.bd:after,.bk:after{content:"";position:absolute;inset:0;background:var(--paper);opacity:.35;pointer-events:none;mix-blend-mode:overlay}
.s>*{position:relative;z-index:1}
.btn{display:inline-flex;align-items:center;gap:8px;padding:15px 30px;font-size:13px;letter-spacing:.2em;text-transform:uppercase;font-weight:500;transition:.3s;border:1px solid var(--bg)}
.btn.main{background:var(--bd);color:var(--bg);border-color:var(--bd)}.btn.main:hover{background:var(--bk);border-color:var(--bk)}
.btn.ghost{border-color:currentColor}.btn.ghost:hover{background:var(--bk);color:var(--bg)}
.bd .btn.main,.bk .btn.main{background:var(--bg);color:var(--bd);border-color:var(--bg)}.bd .btn.main:hover,.bk .btn.main:hover{background:transparent;color:var(--bg)}
header{position:sticky;top:0;z-index:50;background:rgba(17,17,17,.9);backdrop-filter:blur(12px);color:var(--bg);border-bottom:1px solid rgba(232,213,181,.2)}
.bar{display:flex;align-items:center;justify-content:space-between;height:68px;gap:14px}
.logo{font-family:var(--serif);font-size:22px;letter-spacing:.22em;font-weight:800}
