.col:nth-child(1){grid-column:span 4;min-height:460px}.col:nth-child(2){grid-column:span 2;min-height:460px;margin-top:50px}.col:nth-child(5){grid-column:span 3}.col:nth-child(4){margin-top:30px}
.col img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .8s;filter:sepia(.3) contrast(1.05)}.col:hover img{transform:scale(1.07)}
.col:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 40%,rgba(17,5,5,.88))}
.col div{position:absolute;left:22px;right:22px;bottom:20px;z-index:2}.col h3{font-size:30px;font-weight:800}.col span{font-size:12px;letter-spacing:.2em;text-transform:uppercase;display:flex;gap:6px;align-items:center;margin-top:8px;color:var(--pp)}
.flt{border:1px solid var(--bk);padding:22px;margin-bottom:46px;display:grid;gap:16px;background:rgba(245,235,221,.5)}
.row{display:flex;flex-wrap:wrap;gap:8px;align-items:center}.row>label{font-size:12px;letter-spacing:.2em;text-transform:uppercase;min-width:96px}
.chip{padding:8px 16px;border:1px solid var(--bk);font-size:13px;transition:.2s}.chip:hover{background:var(--pp)}.chip.on{background:var(--bk);color:var(--bg)}
.dot{width:11px;height:11px;border-radius:50%;display:inline-block;margin-right:6px;border:1px solid #0005}
select,input[type=search]{font:inherit;padding:10px 14px;border:1px solid var(--bk);background:var(--ml);color:var(--bk);outline:0}
input[type=range]{accent-color:var(--bd);width:190px}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:46px 24px;align-items:start}
.grid .card:nth-child(4n+2){margin-top:36px}.grid .card:nth-child(4n+4){margin-top:72px}.grid .card:nth-child(3n) .ph{aspect-ratio:3/4}
.card{display:flex;flex-direction:column;transition:transform .35s}.card:hover{transform:translateY(-5px)}
.ph{position:relative;aspect-ratio:4/5;overflow:hidden;background:var(--bd);cursor:pointer;outline:1px solid currentColor;outline-offset:6px;opacity:.98}.ph img{width:100%;height:100%;object-fit:cover;transition:transform .7s;filter:sepia(.25) contrast(1.05) saturate(.95)}.card:hover .ph img{transform:scale(1.07)}
.lb{position:absolute;top:0;left:0;font-size:11px;letter-spacing:.2em;text-transform:uppercase;padding:6px 12px;background:var(--ml);color:var(--bd)}.lb.hit{background:var(--bd);color:var(--bg)}
.fv{position:absolute;top:10px;right:10px;width:38px;height:38px;background:rgba(17,17,17,.7);color:var(--bg);display:grid;place-items:center;transition:.25s}.fv:hover{background:var(--bd)}.fv.on svg{fill:var(--bg)}
.cb{padding:20px 2px 0;display:flex;flex-direction:column;gap:6px;flex:1}.cb h3{font-size:25px;font-weight:800}.cb p{font-size:14px;opacity:.75;flex:1}
.pr{display:flex;align-items:center;justify-content:space-between;margin-top:10px;border-top:1px solid currentColor;padding-top:12px}.pr b{font-family:var(--serif);font-size:24px;color:var(--bd)}.bk .pr b,.bd .pr b{color:var(--pp)}
.add{width:44px;height:44px;background:var(--bd);color:var(--bg);display:grid;place-items:center;transition:.25s}.add:hover{background:var(--bk);transform:rotate(90deg)}.bd .add,.bk .add{background:var(--bg);color:var(--bd)}
.empty{grid-column:1/-1;text-align:center;padding:50px;opacity:.8}
.rail{display:flex;gap:30px;overflow-x:auto;scroll-snap-type:x mandatory;padding:10px 8px 26px;scrollbar-width:none}.rail::-webkit-scrollbar{display:none}.rail .card{flex:0 0 290px;scroll-snap-align:start}
.arr{display:flex;gap:10px;margin-top:10px}.arr button{width:50px;height:50px;border:1px solid currentColor;display:grid;place-items:center;transition:.25s}.arr button:hover{background:var(--bg);color:var(--bd)}
.auth{display:grid;grid-template-columns:repeat(4,1fr);gap:46px 24px;align-items:start}.auth .card:nth-child(odd){margin-top:46px}
.story{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center}
.story .im{position:relative;padding-bottom:40px}.story .im img{filter:sepia(.3) contrast(1.05)}.story .im .m{width:82%;aspect-ratio:4/5;object-fit:cover;border:10px solid var(--ml);box-shadow:0 20px 40px rgba(0,0,0,.4);transform:rotate(-2deg)}
.story .im .s2{position:absolute;right:0;bottom:0;width:46%;aspect-ratio:1;object-fit:cover;border:8px solid var(--ml);transform:rotate(4deg);box-shadow:0 14px 30px rgba(0,0,0,.4)}
.story h2{font-size:clamp(34px,5vw,64px);font-weight:800;text-transform:uppercase;margin:12px 0 22px}.story h2 i{font-weight:500;text-transform:none}.story p{margin-bottom:14px;font-weight:300;font-size:17px;opacity:.9}
.story q{display:block;font-family:var(--serif);font-style:italic;font-size:26px;margin:24px 0;border-left:3px solid var(--pp);padding-left:18px}
.adv{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid rgba(232,213,181,.3)}.adv div{padding:34px 24px;border-right:1px solid rgba(232,213,181,.3)}.adv div:last-child{border:0}
.adv b{font-family:var(--serif);font-size:64px;font-weight:800;line-height:1;color:transparent;-webkit-text-stroke:1px var(--bg);display:block;margin-bottom:12px}.adv h3{font-size:22px;margin-bottom:6px}.adv p{font-size:14px;opacity:.75}
.dl{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border:1px solid var(--bk)}.dc{padding:32px 24px;border-right:1px solid var(--bk);transition:.3s}.dc:last-child{border:0}.dc:hover{background:var(--bk);color:var(--bg)}
.dc .ci{margin-bottom:18px}.dc .ci svg{width:34px;height:34px}.dc h3{font-size:24px;margin-bottom:8px}.dc p{font-size:14px;opacity:.8}.dlb{margin-top:34px}
footer{background:var(--bk);color:var(--bg);padding:90px 0 24px;position:relative;overflow:hidden}footer:before{content:"";position:absolute;left:0;right:0;top:-15px;height:16px;background:var(--bk);-webkit-mask:var(--torn) repeat-x 0 0/240px 16px;mask:var(--torn) repeat-x 0 0/240px 16px}
.big{font-family:var(--serif);font-weight:800;font-size:clamp(40px,10.5vw,150px);line-height:.9;text-transform:uppercase;color:transparent;-webkit-text-stroke:1px var(--bg);margin-bottom:50px;letter-spacing:-.02em}
.fg{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:34px}footer h4{font-size:20px;margin-bottom:14px}footer p,footer li{font-size:14px;opacity:.8;list-style:none;margin-bottom:8px}footer a:hover{color:#fff}
.soc{display:flex;flex-wrap:wrap;gap:10px;margin-top:16px}.soc a{border:1px solid rgba(232,213,181,.4);padding:8px 14px;font-size:12px;letter-spacing:.15em;text-transform:uppercase;transition:.25s}.soc a:hover{background:var(--bg);color:var(--bd)}
.cp{border-top:1px solid rgba(232,213,181,.2);margin-top:40px;padding-top:20px;font-size:12px;opacity:.6;letter-spacing:.1em}
.ov{position:fixed;inset:0;background:rgba(10,3,3,.65);backdrop-filter:blur(3px);opacity:0;pointer-events:none;transition:.35s;z-index:90}.ov.on{opacity:1;pointer-events:auto}
.pn{position:fixed;top:0;bottom:0;width:min(420px,100vw);background:var(--bk) var(--paper);color:var(--bg);z-index:100;display:flex;flex-direction:column;transition:transform .45s cubic-bezier(.2,.8,.2,1);box-shadow:0 0 60px rgba(0,0,0,.6)}
.pn.l{left:0;transform:translateX(-105%);border-right:3px solid var(--bd)}.pn.r{right:0;transform:translateX(105%);border-left:3px solid var(--bd)}.pn.on{transform:none}
.ph2{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;background:var(--bd);border-bottom:1px solid rgba(232,213,181,.3)}.ph2 h3{font-size:30px;font-weight:800;text-transform:uppercase}.x{width:40px;height:40px;display:grid;place-items:center}.x:hover{background:rgba(232,213,181,.15)}
.pb{flex:1;overflow-y:auto;padding:18px 24px;overscroll-behavior:contain}.pf{padding:20px 24px;border-top:1px solid rgba(232,213,181,.3);background:var(--bd)}
.cl{display:flex;flex-direction:column}.cl button{text-align:left;padding:16px 4px;border-bottom:1px solid rgba(232,213,181,.25);font-family:var(--serif);font-size:25px;display:flex;justify-content:space-between;align-items:center;transition:.2s}.cl button:hover{padding-left:12px;color:#fff}.cl small{font-family:var(--sans);font-size:13px;opacity:.6}
.mn{display:none;margin-bottom:18px;gap:8px;flex-wrap:wrap}.pn .chip{border-color:var(--bg);color:var(--bg)}.pn .chip:hover{background:rgba(232,213,181,.15)}
.it{display:grid;grid-template-columns:72px 1fr auto;gap:14px;align-items:center;padding:14px 0;border-bottom:1px solid rgba(232,213,181,.25)}.it img{width:72px;height:90px;object-fit:cover;background:var(--bd);filter:sepia(.25)}.it h4{font-size:20px;font-weight:700;line-height:1.15}.it small{opacity:.7;font-size:13px}
.qt{display:inline-flex;align-items:center;margin-top:6px;border:1px solid rgba(232,213,181,.5)}.qt button{width:30px;height:30px;font-size:16px}.qt button:hover{background:rgba(232,213,181,.18)}.qt span{min-width:26px;text-align:center;font-size:14px}
.rm{font-size:12px;text-decoration:underline;display:block;margin-top:6px;margin-left:auto;opacity:.7}.ip{text-align:right;font-weight:500}
.tot{display:flex;justify-content:space-between;font-family:var(--serif);font-size:26px;margin-bottom:14px}.pf .btn{width:100%;justify-content:center;background:var(--bg);color:var(--bd);border-color:var(--bg)}.pf .btn:hover{background:transparent;color:var(--bg)}
.sin{width:100%;margin-bottom:14px;background:transparent;color:var(--bg);border-color:var(--bg)}.sin::placeholder{color:var(--bg);opacity:.5}
.pn .btn.ghost,.pn .btn.main{background:transparent;color:var(--bg);border-color:var(--bg)}
.md{position:fixed;left:50%;top:50%;transform:translate(-50%,-46%) scale(.97);width:min(900px,94vw);max-height:92vh;overflow:auto;background:var(--bd) var(--paper);color:var(--bg);z-index:120;opacity:0;pointer-events:none;transition:.35s;box-shadow:0 30px 80px rgba(0,0,0,.6);border:1px solid rgba(232,213,181,.3)}.md.on{opacity:1;pointer-events:auto;transform:translate(-50%,-50%)}
.mg{display:grid;grid-template-columns:1fr 1fr}.mg>img{width:100%;height:100%;min-height:380px;object-fit:cover;filter:sepia(.2)}.mi{padding:36px 30px;position:relative}.mi h2{font-size:40px;font-weight:800;margin:8px 0 12px}.mi p{opacity:.85;margin-bottom:12px}.mi ul{margin:0 0 18px 18px;opacity:.85;font-size:15px}.mi .big{font-size:36px;margin:6px 0 18px;-webkit-text-stroke:0;color:var(--pp);letter-spacing:0;line-height:1}.mi .x{position:absolute;top:10px;right:10px}
.md .btn.main{background:var(--bg);color:var(--bd);border-color:var(--bg)}.md .btn.ghost:hover{background:var(--bg);color:var(--bd)}
.cta{display:flex;flex-wrap:wrap;gap:12px}.tx{padding:44px 34px;position:relative}.tx h2{margin-bottom:16px;font-size:38px;font-weight:800}.tx p{margin-bottom:10px;opacity:.85}
#toasts{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);z-index:200;display:flex;flex-direction:column;gap:8px;align-items:center;width:max-content;max-width:92vw}
.ts{background:var(--bg);color:var(--bd);padding:12px 22px;font-size:13px;letter-spacing:.06em;box-shadow:0 10px 30px rgba(0,0,0,.4);animation:ti .4s both;border-left:4px solid var(--bd)}.ts.o{animation:to .4s both}
@keyframes ti{from{opacity:0;transform:translateY(14px)}}@keyframes to{to{opacity:0;transform:translateY(14px)}}
#up{position:fixed;right:16px;bottom:18px;width:48px;height:48px;background:var(--bd);color:var(--bg);border:1px solid var(--bg);display:grid;place-items:center;z-index:60;opacity:0;pointer-events:none;transition:.3s;transform:translateY(10px)}#up.on{opacity:1;pointer-events:auto;transform:none}
.rv{opacity:0;transform:translateY(24px);transition:opacity 1s,transform 1s;filter:sepia(.5)}.rv.in{opacity:1;transform:none;filter:none}
@media(max-width:1000px){.grid,.auth{grid-template-columns:repeat(3,1fr)}.dl,.adv{grid-template-columns:repeat(2,1fr)}.dc:nth-child(2),.adv div:nth-child(2){border-right:0}.dc:nth-child(-n+2),.adv div:nth-child(-n+2){border-bottom:1px solid rgba(128,128,128,.5)}.fg{grid-template-columns:1fr 1fr}}
@media(max-width:860px){nav{display:none}.burger{display:grid}.mn{display:flex}.hg,.story,.mg{grid-template-columns:1fr}.hv{min-height:420px}.hv .ph1{inset:0}.cols{grid-template-columns:1fr 1fr}.col,.col:nth-child(n){grid-column:span 1;min-height:260px;margin-top:0}.col:nth-child(1),.col:nth-child(5){grid-column:span 2}.mg>img{min-height:260px;max-height:300px}.s{padding:70px 0}.grid .card:nth-child(n),.auth .card:nth-child(n){margin-top:0}}
@media(max-width:620px){.grid,.auth{grid-template-columns:repeat(2,1fr);gap:30px 14px}.cb h3{font-size:19px}.cb p{display:none}.pr b{font-size:20px}.add{width:38px;height:38px}.logo{font-size:17px;letter-spacing:.14em}.ib{width:38px;height:38px}.bar{height:60px}.col h3{font-size:22px}.col div{left:14px;right:14px}.dl,.adv{grid-template-columns:1fr}.dc,.adv div{border-right:0!important;border-bottom:1px solid rgba(128,128,128,.5)!important}.dc:last-child,.adv div:last-child{border-bottom:0!important}.fg{grid-template-columns:1fr}.row>label{width:100%}.rail .card{flex-basis:230px}.mi{padding:24px 20px}.btn{padding:14px 22px}.wrap{padding:0 16px}.hv{min-height:360px}.ph,.col{outline-offset:4px}.flt{padding:16px}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}

[hidden]{display:none!important}
.hero.bk{background:radial-gradient(circle at 78% 35%,#5a1010 0,#111 62%)}.hero.bk h1{color:var(--bg)}.hero.bk h1 span{color:var(--pp)}.hero.bk .sub{border-color:var(--bd)}.hero.bk .btn.ghost:hover{background:var(--bg);color:var(--bd)}
